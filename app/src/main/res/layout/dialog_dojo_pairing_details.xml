<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="8dp"
    android:paddingBottom="16dp">

    <!--
      #256: the PRE-PAIR confirmation dialog's detail view, carried by
      MaterialAlertDialogBuilder.setView (title + lead-in message stay on
      the builder). Grey 12sp labels over white 13sp values, values
      wrapped - the fragment_dojo_credentials_bottomsheet row idiom - so
      long onion URLs never bleed into neighboring rows. The directory
      header and the jurisdiction/version/explorer rows default hidden:
      code shows a row only when it carries real data (absent means
      absent, never a placeholder); the URL row is the one guarantee
      (validate) and defaults visible.
    -->
    <LinearLayout
        android:id="@+id/dojoPairingDirectoryHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/dojoPairingDirectoryFlag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:textSize="22sp"
            tools:text="SG" />

        <TextView
            android:id="@+id/dojoPairingDirectoryName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Community Dojo" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dojoPairingJurisdictionRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dojo_pairing_row_jurisdiction"
            android:textColor="#9A9A9A"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/dojoPairingJurisdictionValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="13sp"
            tools:text="Singapore" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dojoPairingUrlRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dojo_pairing_row_url"
            android:textColor="#9A9A9A"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/dojoPairingUrlValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="13sp"
            tools:text="http://abcdef123456.onion/v2" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dojoPairingVersionRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dojo_pairing_row_version"
            android:textColor="#9A9A9A"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/dojoPairingVersionValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="13sp"
            tools:text="1.19.1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dojoPairingExplorerRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dojo_pairing_row_explorer"
            android:textColor="#9A9A9A"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/dojoPairingExplorerValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="13sp"
            tools:text="http://explorer.example" />
    </LinearLayout>

</LinearLayout>
